<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
<script>
    window.appNotifications = {
        checkPermission: function () {
            return 'Notification' in window && Notification.permission === "granted";
        },
        askPermission: async function () {
            if (!('Notification' in window)) return false;
            const result = await Notification.requestPermission();
            return result === "granted";
        },
        send: async function(title, message) {
            if (!('Notification' in window)) {
                throw new Error("Notifications are not supported by this browser.");
            }
            if (Notification.permission !== "granted") {
                throw new Error("Notification permission has not been granted.");
            }

            // Safely check for a Service Worker without hanging
            if ('serviceWorker' in navigator) {
                // Ask the browser if a Service Worker is actually registered right now
                const registration = await navigator.serviceWorker.getRegistration();

                if (registration) {
                    // Only await .ready if a registration actually exists
                    const readyReg = await navigator.serviceWorker.ready;
                    if ('showNotification' in readyReg) {
                        await readyReg.showNotification(title, {
                            body: message,
                            icon: 'icon-192.png' // Ensure you actually have this icon in wwwroot
                        });
                        return; // Exit early if mobile SW notification succeeded
                    }
                }
            }

            // Fallback if no Service Worker exists (Desktop / non-PWA)
            new Notification(title, { body: message });
        }

        // Service Worker path for mobile devices
        if ('serviceWorker' in navigator) {
            const registration = await navigator.serviceWorker.ready.catch(() => null);
            if (registration && 'showNotification' in registration) {
                await registration.showNotification(title, {
                    body: message,
                    icon: 'icon-192.png'
                });
                return;
            }
        }

        // Desktop fallback
        new Notification(title, { body: message });
    }
};

    window.wheelPicker = {
        init: function (elementId, dotnetHelper, methodToCall) 
        {
            const container = document.getElementById(elementId);
            if (!container) return;

            let timeout;
            container.addEventListener('scroll', () => 
            {
                clearTimeout(timeout);
                // Wait briefly after scroll stops to calculate centered item
                timeout = setTimeout(() => 
                {
                    const children = Array.from(container.children);
                    const containerCenter = container.getBoundingClientRect().top + container.clientHeight / 2;

                    let closest = children[0];
                    let minDistance = Infinity;

                    children.forEach(child => 
                        {
                        const childCenter = child.getBoundingClientRect().top + child.clientHeight / 2;
                        const distance = Math.abs(containerCenter - childCenter);
                        if (distance < minDistance) 
                        {
                            minDistance = distance;
                            closest = child;
                        }
                    });

                    const selectedValue = parseInt(closest.innerText, 10);
                    if (!isNaN(selectedValue)) 
                    {
                        dotnetHelper.invokeMethodAsync(methodToCall, selectedValue);
                    }
                }, 100);
            });
        }
    };
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('service-worker.js')
            .then(reg => console.log('Service Worker registered successfully.', reg))
            .catch(err => console.error('Service Worker registration failed:', err));
    }
</script>